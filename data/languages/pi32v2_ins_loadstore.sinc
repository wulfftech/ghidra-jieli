##################
#
# Load/Store
#
##################


#########################################################
# Registers list helpers
#########################################################

macro putreg(reg) { mult_addr = mult_addr - 4; *mult_addr = reg; }
macro getreg(reg) { reg = *mult_addr; mult_addr = mult_addr + 4;}

# Read register from memory
ReadReg: r0 is counter=0 & r0 { getreg(r0); }
ReadReg: r1 is counter=1 & r1 {getreg(r1);}
ReadReg: r2 is counter=2 & r2 {getreg(r2);}
ReadReg: r3 is counter=3 & r3 {getreg(r3);}
ReadReg: r4 is counter=4 & r4 {getreg(r4);}
ReadReg: r5 is counter=5 & r5 {getreg(r5);}
ReadReg: r6 is counter=6 & r6 {getreg(r6);}
ReadReg: r7 is counter=7 & r7 {getreg(r7);}
ReadReg: r8 is counter=8 & r8 {getreg(r8);}
ReadReg: r9 is counter=9 & r9 {getreg(r9);}
ReadReg: r10 is counter=10 & r10 {getreg(r10);}
ReadReg: r11 is counter=11 & r11 {getreg(r11);}
ReadReg: r12 is counter=12 & r12 {getreg(r12);}
ReadReg: r13 is counter=13 & r13 {getreg(r13);}
ReadReg: r14 is counter=14 & r14 {getreg(r14);}
ReadReg: r15 is counter=15 & r15 {getreg(r15);}

# Pop registers based on counter
WriteReg: r0 is counter=0 & r0 {putreg(r0);}
WriteReg: r1 is counter=1 & r1 {putreg(r1);}
WriteReg: r2 is counter=2 & r2 {putreg(r2);}
WriteReg: r3 is counter=3 & r3 {putreg(r3);}
WriteReg: r4 is counter=4 & r4 {putreg(r4);}
WriteReg: r5 is counter=5 & r5 {putreg(r5);}
WriteReg: r6 is counter=6 & r6 {putreg(r6);}
WriteReg: r7 is counter=7 & r7 {putreg(r7);}
WriteReg: r8 is counter=8 & r8 {putreg(r8);}
WriteReg: r9 is counter=9 & r9 {putreg(r9);}
WriteReg: r10 is counter=10 & r10 {putreg(r10);}
WriteReg: r11 is counter=11 & r11 {putreg(r11);}
WriteReg: r12 is counter=12 & r12 {putreg(r12);}
WriteReg: r13 is counter=13 & r13 {putreg(r13);}
WriteReg: r14 is counter=14 & r14 {putreg(r14);}
WriteReg: r15 is counter=15 & r15 {putreg(r15);}

# Bit ops
NextReg: is epsilon [counter=counter+1;]{}
#PrevReg: is epsilon [counter=counter-1;]{}
RegInMap: is imm1631 [bitset=(imm1631 & (1 << counter))>>counter;]{}
WriteCurrentReg: WriteReg is WriteReg & bitset=1 [sep=1;]{}
WriteCurrentReg: is bitset=0 {}
ReadCurrentReg: ReadReg is ReadReg & bitset=1 [sep=1;]{}
ReadCurrentReg: is bitset=0 {}
RegSep: "," is  sep=1 & bitset=1 {}
RegSep: "" is sep=0 | bitset=0 {}

# Recursively generate our write registers
WriteRegsMap: WriteRegsMap^WriteCurrentReg^RegSep is counter<15 & RegInMap & RegSep & WriteCurrentReg & NextReg & WriteRegsMap
    { build WriteRegsMap; build WriteCurrentReg; }
WriteRegsMap: WriteCurrentReg is counter=15 & RegInMap & WriteCurrentReg {}
WriteRegs: WriteRegsMap is WriteRegsMap [bitset=0; counter=0; sep=0;] {}


# Recursively generate our read registers
ReadRegsMap: ReadRegsMap^ReadCurrentReg^RegSep is counter<15 & RegInMap & RegSep & ReadCurrentReg & NextReg & ReadRegsMap
    { build ReadRegsMap; build ReadCurrentReg; }
ReadRegsMap: ReadCurrentReg is counter=15 & RegInMap & ReadCurrentReg {}
ReadRegs: ReadRegsMap is ReadRegsMap [bitset=0; counter=0; sep=0;] {}

##############################################################
# Write a series of registers into [reg]
##############################################################

# Write a series of registers starting at [reg]
# sw {reg, reg, ...}, [reg]
#
:sw {WriteRegs}, [regA] is group=7 & ins0411=0xB2 & regA ; WriteRegs
{
    mult_addr = regA;
    build WriteRegs;
}

##############################################################
# Read a series of registers into [reg]
##############################################################

# Write a series of registers starting at [reg]
# sw {reg, reg, ...}, [reg]
#
:sw {ReadRegs}, [regA] is group=7 & ins0411=0xB0 & regA ; ReadRegs
{
    mult_addr = regA;
    build ReadRegs;
}

###########################################################################################
# Load Double Word
###########################################################################################


# Load double word into register
# rA = [rB+]
#


###########################################################################################
# Load Word
###########################################################################################

#
# rA = [rB ++= 4]
# => lw rA, [rB ++= 4]
#
:lw regAl, [regBl ++= 4] is group=0 & ins0712=0x0A & ins0303=0 & regAl & regBl
{
	regAl = *:4 regBl;
	regBl = regBl + 4;
}

#
# rA = [rB ++= -4]
# => lw rA, [rB --= 4]
#
:lw regAl, [regBl --= 4] is group=0 & ins0712=0x0A & ins0303=1 & regAl & regBl
{
	regAl = *:4 regBl;
	regBl = regBl - 4;
}

#
# rA = [rB+simm7m4]
# => lw rA, [rB + simm7m4]
#
:lw regAl, [regBl + simm7m4] is group=3 & ins0707=0 & ins0303=0 & regAl & regBl & imm0812s
[ simm7m4 = (imm0812s << 2); ]
{
	local addr:4 = regBl + simm7m4;
	regAl = *:4 addr;
}


###########################################################################################
# Load Halfword (zero extend)
###########################################################################################

#
# rA = h[rB ++= 2] (u)
# => lh.z rA, [rB ++= 2]
#
:lh.z regAl, [regBl ++= 2] is group=0 & ins0712=0x0C & ins0303=0 & regAl & regBl
{
	regAl = zext(*:2 regBl);
	regBl = regBl + 2;
}

#
# rA = h[rB ++= -2] (u)
# => lh.z rA, [rB --= 2]
#
:lh.z regAl, [regBl --= 2] is group=0 & ins0712=0x0C & ins0303=1 & regAl & regBl
{
	regAl = zext(*:2 regBl);
	regBl = regBl - 2;
}

#
# rA = h[rB+simm6m2] (u)
# => lh.z rA, [rB + simm6m2]
#
:lh.z regAl, [regBl + simm6m2] is group=3 & ins0707=0 & ins0303=1 & regAl & regBl & imm0812s
[ simm6m2 = (imm0812s << 1); ]
{
	local addr:4 = regBl + simm6m2;
	regAl = zext(*:2 addr);
}


###########################################################################################
# Halfword load/store, [rB + simm10] and [++rB = simm10] (ins0411 = 0xd5)
#
# Verified against Jieli's own llvm-objdump (-mcpu=r3), on every occurrence in a BR28 app.bin and
# on hand-crafted words covering each bit:
#   first halfword  0xed5X, X = P:S:s1:s0
#     P  (ins0303) = 1: pre-increment with writeback, `[++rB = off]`; 0: plain `[rB + off]`
#     S  (ins0202) = 1: signed load / store of the HIGH half of rA (`= rA.h`); 0: zero-extend / low half
#     s1 s0 (imm0001s) = top two bits of the offset, sign-extended
#   second halfword rA(12-15) : off[7:4](8-11) : rB(4-7) : off[3:1](1-3) : st(0), st=1 is a store
#   off = sext10(s1 s0 off[7:1] 0): -512..510, always even, NOT scaled.
#   e.g. ed59 2902 = r2 = h[++r0=402] (u), ed5b 5f3e = r5 = h[++r3=-2] (u),
#        ed5a 0000 = r0 = h[++r0=-512] (u), ed5c 0001 = h[++r0=0] = r0.h, ed53 8f4f = h[r4+-2] = r8
###########################################################################################

:lh.z eregA, [eregB + simm10] is group=7 & ins0411=0xd5 & ins0303=0 & ins0202=0 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=0
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    local addr:4 = eregB + simm10;
    eregA = zext(*:2 addr);
}

:lh.s eregA, [eregB + simm10] is group=7 & ins0411=0xd5 & ins0303=0 & ins0202=1 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=0
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    local addr:4 = eregB + simm10;
    eregA = sext(*:2 addr);
}

:sh eregA, [eregB + simm10] is group=7 & ins0411=0xd5 & ins0303=0 & ins0202=0 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=1
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    local addr:4 = eregB + simm10;
    *:2 addr = eregA:2;
}

:sh eregA^".h", [eregB + simm10] is group=7 & ins0411=0xd5 & ins0303=0 & ins0202=1 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=1
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    local addr:4 = eregB + simm10;
    *:2 addr = eregA(2);
}

:lh.z eregA, [++eregB = #simm10] is group=7 & ins0411=0xd5 & ins0303=1 & ins0202=0 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=0
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    eregB = eregB + simm10;
    eregA = zext(*:2 eregB);
}

:lh.s eregA, [++eregB = #simm10] is group=7 & ins0411=0xd5 & ins0303=1 & ins0202=1 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=0
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    eregB = eregB + simm10;
    eregA = sext(*:2 eregB);
}

:sh eregA, [++eregB = #simm10] is group=7 & ins0411=0xd5 & ins0303=1 & ins0202=0 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=1
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    local v:2 = eregA:2;
    eregB = eregB + simm10;
    *:2 eregB = v;
}

:sh eregA^".h", [++eregB = #simm10] is group=7 & ins0411=0xd5 & ins0303=1 & ins0202=1 & imm0001s ; eregA & imm2427 & eregB & imm1719 & imm1616=1
[ simm10 = (imm0001s << 8) | (imm2427 << 4) | (imm1719 << 1); ]
{
    local v:2 = eregA(2);
    eregB = eregB + simm10;
    *:2 eregB = v;
}

###########################################################################################
# Load Halfword (sign extend)
###########################################################################################


###########################################################################################
# Load Byte (sign-extend)
###########################################################################################


###########################################################################################
# Load Byte (zero extend)
###########################################################################################

#
# rA = b[rB ++= 1] (u)
# => lb.z rA, [rB ++= 1]
#
:lb.z regAl, [regBl ++= 1] is group=0 & ins0712=0x0E & ins0303=0 & regAl & regBl
{
	regAl = zext(*:1 regBl);
	regBl = regBl + 1;
}

#
# rA = b[rB ++= -1] (u)
# => lb.z rA, [rB --= 1]
#
:lb.z regAl, [regBl --= 1] is group=0 & ins0712=0x0E & ins0303=1 & regAl & regBl
{
	regAl = zext(*:1 regBl);
	regBl = regBl - 1;
}


#
# rA = b[rB+simm5] (u)
# => lb.z rA, [rB + simm5]
#
:lb.z regAl, [regBl + imm0812s] is group=2 & ins0707=0 & ins0303=1 & regAl & regBl & imm0812s
{
	local addr:4 = regBl + imm0812s;
	regAl = zext(*:1 addr);
}


###########################################################################################
# Store Double Word
###########################################################################################


###########################################################################################
# Store Word
###########################################################################################

#
# [rB ++= 4] = rA
# => sw rA, [rB ++= 4]
#
:sw regAl, [regBl ++= 4] is group=0 & ins0712=0x0B & ins0303=0 & regAl & regBl
{
	*:4 regBl = regAl;
	regBl = regBl + 4;
}

#
# [rB ++= -4] = rA
# => sw rA, [rB --= 4]
#
:sw regAl, [regBl --= 4] is group=0 & ins0712=0x0B & ins0303=1 & regAl & regBl
{
	*:4 regBl = regAl;
	regBl = regBl - 4;
}

#
# [rB+simm7m4] = rA
# => sw rA, [rB + simm7m4]
#
:sw regAl, [regBl + simm7m4] is group=3 & ins0707=1 & ins0303=0 & regAl & regBl & imm0812s
[ simm7m4 = (imm0812s << 2); ]
{
	local addr:4 = regBl + simm7m4;
	*:4 addr = regAl:4;
}


###########################################################################################
# Store halfword
###########################################################################################

#
# h[rB ++= 2] = rA
# => sh rA, [rB ++= 2]
#
:sh regAl, [regBl ++= 2] is group=0 & ins0712=0x0D & ins0303=0 & regAl & regBl
{
	*:2 regBl = regAl:2;
	regBl = regBl + 2;
}

#
# h[rB ++= -2] = rA
# => sh rA, [rB --= 2]
#
:sh regAl, [regBl --= 2] is group=0 & ins0712=0x0D & ins0303=1 & regAl & regBl
{
	*:2 regBl = regAl:2;
	regBl = regBl - 2;
}

#
# h[rB+simm6m2] = rA
# => sh rA, [rB + simm6m2]
#
:sh regAl, [regBl + simm6m2] is group=3 & ins0707=1 & ins0303=1 & regAl & regBl & imm0812s
[ simm6m2 = (imm0812s << 1); ]
{
	local addr:4 = regBl + simm6m2;
	*:2 addr = regAl:2;
}


###########################################################################################
# Store Byte
###########################################################################################

#
# b[rB ++= 1] = rA
# => sb rA, [rB ++= 1]
#
:sb regAl, [regBl ++= 1] is group=0 & ins0712=0x0F & ins0303=0 & regAl & regBl
{
	*:1 regBl = regAl:1;
	regBl = regBl + 1;
}

#
# b[rB ++= -1] = rA
# => sb rA, [rB -= 1]
#
:sb regAl, [regBl --= 1] is group=0 & ins0712=0x0F & ins0303=1 & regAl & regBl
{
	*:1 regBl = regAl:1;
	regBl = regBl - 1;
}

#
# b[rB+simm5] = rA
# => sb rA, [rB + simm5]
#
:sb regAl, [regBl + imm0812s] is group=2 & ins0707=1 & ins0303=1 & regAl & regBl & imm0812s
{
	local addr:4 = regBl + imm0812s;
	*:1 addr = regAl:1;
}


###########################################################################################
# Group-0 register post-increment: rA = x[rB ++= rC] / x[rB ++= rC] = rA (16-bit)
#
# halfword: size(10-12) : rC-8 (7-9) : rB (4-6) : store (3) : rA (0-2)
#   size 2 = word, 3 = halfword (zero-extending load), 4 = byte (zero-extending load)
#   rA, rB are r0-r7; rC is r8-r15. Access [rB], then rB += rC.
#   No parallel (prefix 6) form: the vendor rejects c806, though 0806 may sit in a pair's 2nd slot.
# Verified against Jieli's llvm-objdump -mcpu=r3 on every occurrence in a BR28 app.bin and on
# hand-built words: 0806 = r6 = [r0++=r8], 0bff = [r7++=r15] = r7, 0c0a = h[r0++=r8] = r2,
# 1317 = r7 = b[r1++=r14] (u), 13ff = b[r7++=r15] = r7.
###########################################################################################

:lw regAl, [regBl ++= regCh] is group=0 & parallel=0 & ins1012=2 & ins0303=0 & regAl & regBl & regCh
{
    regAl = *:4 regBl;
    regBl = regBl + regCh;
}

:sw regAl, [regBl ++= regCh] is group=0 & parallel=0 & ins1012=2 & ins0303=1 & regAl & regBl & regCh
{
    *:4 regBl = regAl;
    regBl = regBl + regCh;
}

:lh.z regAl, [regBl ++= regCh] is group=0 & parallel=0 & ins1012=3 & ins0303=0 & regAl & regBl & regCh
{
    regAl = zext(*:2 regBl);
    regBl = regBl + regCh;
}

:sh regAl, [regBl ++= regCh] is group=0 & parallel=0 & ins1012=3 & ins0303=1 & regAl & regBl & regCh
{
    *:2 regBl = regAl:2;
    regBl = regBl + regCh;
}

:lb.z regAl, [regBl ++= regCh] is group=0 & parallel=0 & ins1012=4 & ins0303=0 & regAl & regBl & regCh
{
    regAl = zext(*:1 regBl);
    regBl = regBl + regCh;
}

:sb regAl, [regBl ++= regCh] is group=0 & parallel=0 & ins1012=4 & ins0303=1 & regAl & regBl & regCh
{
    *:1 regBl = regAl:1;
    regBl = regBl + regCh;
}

###########################################################################################
# Byte load/store with immediate increment (verified against Jieli llvm-objdump)
###########################################################################################

###########################################################################################
# Group-7 indexed load/store, GENERATED by iot-devices
# jieli-digital-badge/tools/ghidra/differential/gen_memidx.py. Every form verified against
# Jieli's llvm-objdump -mcpu=r3; see the generator for the field layout.
###########################################################################################

:lb.z eregA, [eregB + #simm9] is group=7 & ins0411=0xe5 & ins0303=0 & ins0202=0 & ins0101=0 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    local addr:4 = eregB + simm9;
    eregA = zext(*:1 addr);
}

:lb.s eregA, [eregB + #simm9] is group=7 & ins0411=0xe5 & ins0303=0 & ins0202=1 & ins0101=0 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    local addr:4 = eregB + simm9;
    eregA = sext(*:1 addr);
}

:sb eregA, [eregB + #simm9] is group=7 & ins0411=0xe5 & ins0303=0 & ins0202=0 & ins0101=1 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    local addr:4 = eregB + simm9;
    *:1 addr = eregA:1;
}

:lb.z eregA, [++eregB = #simm9] is group=7 & ins0411=0xe5 & ins0303=1 & ins0202=0 & ins0101=0 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    eregB = eregB + simm9;
    eregA = zext(*:1 eregB);
}

:lb.s eregA, [++eregB = #simm9] is group=7 & ins0411=0xe5 & ins0303=1 & ins0202=1 & ins0101=0 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    eregB = eregB + simm9;
    eregA = sext(*:1 eregB);
}

:sb eregA, [++eregB = #simm9] is group=7 & ins0411=0xe5 & ins0303=1 & ins0202=0 & ins0101=1 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    local v:1 = eregA:1;
    eregB = eregB + simm9;
    *:1 eregB = v;
}

:lb.z eregA, [eregB ++= #simm9] is group=7 & ins0411=0xed & ins0303=0 & ins0202=0 & ins0101=0 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    local a:4 = eregB;
    eregB = eregB + simm9;
    eregA = zext(*:1 a);
}

:lb.s eregA, [eregB ++= #simm9] is group=7 & ins0411=0xed & ins0303=0 & ins0202=1 & ins0101=0 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    local a:4 = eregB;
    eregB = eregB + simm9;
    eregA = sext(*:1 a);
}

:sb eregA, [eregB ++= #simm9] is group=7 & ins0411=0xed & ins0303=0 & ins0202=0 & ins0101=1 & imm0000 ; eregA & imm2427 & eregB & imm1619
[ simm9 = (imm0000 * -256) | (imm2427 << 4) | imm1619; ]
{
    *:1 eregB = eregA:1;
    eregB = eregB + simm9;
}

:lb.z eregA, [eregB + eregC] is group=7 & ins0011=0xed8 ; eregA & eregC & eregB & imm1619=0
{
    local addr:4 = eregB + eregC;
    eregA = zext(*:1 addr);
}

:sb eregA, [eregB + eregC] is group=7 & ins0011=0xed8 ; eregA & eregC & eregB & imm1619=1
{
    local addr:4 = eregB + eregC;
    *:1 addr = eregA:1;
}

:lb.s eregA, [eregB + eregC] is group=7 & ins0011=0xed8 ; eregA & eregC & eregB & imm1619=2
{
    local addr:4 = eregB + eregC;
    eregA = sext(*:1 addr);
}

:lb.z eregA, [++eregB = eregC] is group=7 & ins0011=0xedc ; eregA & eregC & eregB & imm1619=0
{
    eregB = eregB + eregC;
    eregA = zext(*:1 eregB);
}

:sb eregA, [++eregB = eregC] is group=7 & ins0011=0xedc ; eregA & eregC & eregB & imm1619=1
{
    local v:1 = eregA:1;
    eregB = eregB + eregC;
    *:1 eregB = v;
}

:lb.s eregA, [++eregB = eregC] is group=7 & ins0011=0xedc ; eregA & eregC & eregB & imm1619=2
{
    eregB = eregB + eregC;
    eregA = sext(*:1 eregB);
}

:lb.z eregA, [eregB ++= eregC] is group=7 & ins0011=0xede ; eregA & eregC & eregB & imm1619=0
{
    local a:4 = eregB;
    eregB = eregB + eregC;
    eregA = zext(*:1 a);
}

:sb eregA, [eregB ++= eregC] is group=7 & ins0011=0xede ; eregA & eregC & eregB & imm1619=1
{
    *:1 eregB = eregA:1;
    eregB = eregB + eregC;
}

