##################
#
# Arithmetic Operations
#
##################

###########################################################################################
# Add
###########################################################################################

#
# rA += rB
# => add rA, rB
#
:add regA, regB is group=0 & ins0812=0x18 & regA & regB
{
	regA = regA + regB;
}

#
# rA = rB + rC
# => add rA, rB, rC
#
:add regAl, regBl, regCxl is group=0 & ins0912=0xE & regAl & regBl & regCxl
{
	regAl = regBl + regCxl;
}

#
# rA += imm8
# => add rA, #imm8
#
:add regAl, #imm8 is group=1 & ins0607=3 & regAl & imm0305s & imm0812
[ imm8 = (imm0305s << 5) | imm0812; ]
{
	regAl = regAl + imm8;
}

#
# sp += imm10
# => add sp, #imm10
#
:add sp, #imm10 is group=4 & ins0004=0x02 & imm0812 & imm0507s & sp
[ imm10 = (imm0507s << 7) | (imm0812 << 2); ]
{
	sp = sp + imm10;
}

#
# rA = rB + imm5
# => add rA, rB, #imm5
#
:add regAl, regBl, #imm0812 is group=4 & ins0707=0 & ins0303=1 & regAl & regBl & imm0812
{
	regAl = regBl + imm0812;
}

#
# rA = sp + imm7
# => add rA, sp, #imm7
#
:add regAl, sp, #imm7 is group=4 & ins0707=1 & ins0304=1 & regAl & sp & imm0812 & imm0506
[ imm7 = (imm0506 << 5) | imm0812; ]
{
	regAl = sp + imm7;
}

#
# rA = sp + imm12
# => add rA, sp, #imm12
#
:add eregA, sp, #imm1627 is group=7 & ins0011=0x8f8 ; eregA & imm1627 & sp
{
    eregA = sp + imm1627;
}

#
# rA = rB + imm12
# => add rA, rb, #imm12
#
:add regA, eregA, #imm1627 is group=7 & ins0411=0x10 & regA ; eregA & imm1627
{
    regA = eregA + imm1627;
}

#
# rA = rB + imm12s
# => add rA, rb, #imm12
#
# 0x10 / 0x11 / 0x12 / 0x13 cover +0..4095 / +4096..8191 / -8192..-4097 / -4096..-1
# (vendor: e130 1000 = r1 + -4096, e130 1fff = r1 + -1, e13a 0000 = r0 + -4096).
:add regA, eregA, #imm13 is group=7 & ins0411=0x13 & regA ; eregA & imm1627
[ imm13 = imm1627 - 4096; ]
{
    regA = eregA + imm13;
}

#
# rA = rB + -imm12
# => add rA, rb, #imm12
#
:add regA, eregA, #imm14 is group=7 & ins0411=0x12 & regA & imm0405; eregA & imm1627
[ imm14 = -(((imm1627 | (imm0405<<12))^0x3fff)+1);]
{
    regA = eregA + imm14;
}

#
# rA = rB + (imm12 + 4096)
# => add rA, rb, #imm12
#
:add regA, eregA, imm12p4096 is group=7 & ins0411=0x11 & regA ; eregA & imm1627
[ imm12p4096 = imm1627 + 4096; ]
{
    regA = eregA + imm12p4096;
}

#
# rA = rB + packedimm12
# => add rA, rB, #packedimm12
#
:add regA, eregA, packedimm12 is group=7 & ins0411=0x0e & regA ; eregA & packedimm12
{
    regA = eregA + packedimm12;
}


#
# rA = rB + rC
# => add rA, rB, rC
#
:add eregA, eregB, eregC is group=7 & ins0011=0xB4 ; eregA & eregB & eregC & imm1619=0
{
    eregA = eregB + eregC;
}

# Add registers + carry into reg
# rA = rB + rC + C
# => addc rA, rB, rC
#
:addc eregA, eregB, eregC is group=7 & ins0011=0xB8 ; eregA & eregB & eregC & imm1619=0
{
    # TODO: handle carry
    eregA = eregB + eregC;
}

#
# rB_rA += rC * rD (signed)
# => muladd.s rB_rA, rC, rD
#
:muladd.s edregA, eregB, eregC is group=7 & ins0011=0x1fc ; edregA & eregB & eregC & imm1619=0 & imm2828=1
{
    # Zero-extend eregC and eregB
    C:8 = sext(eregC);
    B:8 = sext(eregB); 

    # Multiply and add to edregA
    edregA = edregA + C*B;
}

#
# rB_rA += rC * rD (unsigned)
# => muladd.s rB_rA, rC, rD
#
:muladd.s edregA, eregB, eregC is group=7 & ins0011=0x1fc ; edregA & eregB & eregC & imm1619=0 & imm2828=0
{
    # Zero-extend eregC and eregB
    C:8 = zext(eregC);
    B:8 = zext(eregB); 

    # Multiply and add to edregA
    edregA =edregA + C*B;
}


###########################################################################################
# Subtract
###########################################################################################

#
# rA = rB - rC
# => sub rA, rB, rC
#
:sub regAl, regBl, regCxl is group=0 & ins0912=0xF & regAl & regBl & regCxl
{
	regAl = regBl - regCxl;
}


#
# rA = packedimm12 - rB
# => sub bitmask, #packedimm12
#
:sub regA, #packedimm12, eregA is group=7 & ins0411=0x0A & regA ; eregA & packedimm12
{
    regA = packedimm12 - eregA;
}

#
# rA = rB - rC
# => sub rA, rB, rC
#
:sub eregA, eregB, eregC is group=7 & ins0011=0xB4 ; eregA & eregB & eregC & imm1619=2
{
    eregA = eregB - eregC;
}

# Substract registers and not(C)
# rA = rB - rC - !C
# => subc rA, rB, rC
#
:subc eregA, eregB, eregC is group=7 & ins0011=0xB8 ; eregA & eregB & eregC & imm1619=2
{
    # TODO: handle carry !
    eregA = eregB - eregC;
}

#
# rA = rB - packedimm12
# => sub rA, rB, #imm
:sub regA, eregA, #packedimm12 is group=7 & ins0411=0x0f & regA ; eregA & packedimm12
{
    regA = eregA - packedimm12;
}

###########################################################################################
# Multiply
###########################################################################################

#
# rA *= rB
# => mul rA, rB
#
:mul regA, regB is group=0 & ins0812=0x1B & regA & regB
{
	regA = regA * regB;
}

#
# rA = rC * rB
# => mul rA, rC, rB
#
:mul eregA, eregB, eregC is group=7 & ins0011=0x1f0 ; eregA & eregB & eregC & imm1619=0
{
    eregA = eregC * eregB;
}

#
# rB_rA = rC * rD (signed)
# => mul rB_rA, rC, rD
#
:mul edregA, eregB, eregC is group=7 & ins0011=0x1f8 ; edregA & eregB & eregC & imm1619=0 & imm2828=0
{
    # Sign-extend eregC and eregB
    C:8 = sext(eregC);
    B:8 = sext(eregB); 

    # Multiply
    edregA = C*B;
}


#
# rB_rA = rC * rD (unsigned)
# => mul rB_rA, rC, rD
#
:mul.z edregA, eregB, eregC is group=7 & ins0011=0x1f8 ; edregA & eregB & eregC & imm1619=0 & imm2828=1
{
    # Zero-extend eregC and eregB
    C:8 = zext(eregC);
    B:8 = zext(eregB); 

    # Multiply
    edregA = C*B;
}


#
# rA = rB * packedimm12
#
:mul regA, eregA, #packedimm12 is group=7 & ins0411=0x1e & regA ; eregA & imm1623 & packedimm12
{
    regA = eregA * packedimm12;
}

###########################################################################################
# Divide
###########################################################################################

#
# rA = rC / rB (unsigned)
# => div.s rA, rC, rB
#
:div eregA, eregC, eregB is group=7 & ins0011=0x1f4 ; eregA & eregB & eregC & imm1619=0
{

    eregA = eregC / eregB;
}

#
# rA = rC / rB (signed)
# => div.s rA, rC, rB
#
:div.s eregA, eregC, eregB is group=7 & ins0011=0x1f4 ; eregA & eregB & eregC & imm1619=1
{

    eregA = eregC s/ eregB;
}


###########################################################################################
# Absolute value
###########################################################################################

#
# rA = abs(rB)
#
:abs eregA, eregC is group=7 & ins0011=0x430 ; eregA & eregC & imm1623=0
{
    if (eregC s>=0) goto <skip>;
    eregA = (eregC ^ 0xffffffff) + 1;
    goto inst_next;
<skip>
    eregA = eregC;
}

###########################################################################################
# Min value
###########################################################################################

#
# rA = umin(rB, rC) (unsigned)
#
:umin eregA, eregB, eregC is group=7 & ins0011=0x435 ; eregA & eregB & eregC & imm1619=0
{
    if (eregB <= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

#
# rA = smin(rB, rC) (signed)
#
:smin eregA, eregB, eregC is group=7 & ins0011=0x435 ; eregA & eregB & eregC & imm1619=1
{
    if (eregB s<= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

###########################################################################################
# Max value (e434; mirrors umin/smin at e435; verified against Jieli llvm-objdump)
###########################################################################################

#
# rA = umax(rB, rC) (unsigned)
#
:umax eregA, eregB, eregC is group=7 & ins0011=0x434 ; eregA & eregB & eregC & imm1619=0
{
    if (eregB >= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

#
# rA = smax(rB, rC) (signed)
#
:smax eregA, eregB, eregC is group=7 & ins0011=0x434 ; eregA & eregB & eregC & imm1619=1
{
    if (eregB s>= eregC) goto <skip>;
    eregA = eregC;
    goto inst_next;
<skip>
    eregA = eregB;
}

###########################################################################################
# Single-precision float ops, ins0011 = 0x53f (0xe53f; 0xf53f is the parallel-issue form).
# hw2 = rA(12-15) : rC(8-11) : rB(4-7) : op(0-3). Verified against Jieli's llvm-objdump -mcpu=r3:
#   op 0-3  rA = rB + - * / rC (f)        op 4  fcmp rB, rC        op 5/6  rA = fmin/fmax(rB, rC)
#   op 7/8  rA += / -= rB * rC (f)        op 9-e  invalid
#   op f    unary on rC, selected by bits 4-7: 0-3 ftoi, 4-7 ftou (rounding even/trunc/ceil/floor),
#           8 itof, 9 utof, a rA.l = f32->f16, b f16->f32 from rC.l, c-f round to integral float
# e.g. e53f 7210 = r7 = r1 + r2 (f), e53f 448f = r4 = itof(r4), e53f b71f = r11 = ftoi(r7) (trunc),
#      e53f 5447 = r5 += r4 * r4 (f), e53f 5455 = r5 = fmin(r5, r4).
# Modelling limits: "even" rounding uses p-code round() (nearest, ties away from zero); ftou uses the
# signed trunc(); fcmp's flag effects and the f16 conversions are opaque pcodeops.
###########################################################################################

define pcodeop FloatCompare;
define pcodeop FloatToHalf;
define pcodeop HalfToFloat;

:fadd eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=0 { eregA = eregB f+ eregC; }
:fsub eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=1 { eregA = eregB f- eregC; }
:fmul eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=2 { eregA = eregB f* eregC; }
:fdiv eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=3 { eregA = eregB f/ eregC; }
:fcmp eregB, eregC is group=7 & ins0011=0x53f ; eregC & eregB & imm1619=4 { FloatCompare(eregB, eregC); }
:fmin eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=5
{
    local r = eregB;
    if (eregB f<= eregC) goto <done>;
    r = eregC;
<done>
    eregA = r;
}
:fmax eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=6
{
    local r = eregB;
    if (eregC f<= eregB) goto <done>;
    r = eregC;
<done>
    eregA = r;
}
:fmac eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=7 { eregA = eregA f+ (eregB f* eregC); }
:fmsc eregA, eregB, eregC is group=7 & ins0011=0x53f ; eregA & eregC & eregB & imm1619=8 { eregA = eregA f- (eregB f* eregC); }

:ftoi.rn eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x0 & imm1619=0xf { eregA = trunc(round(eregC)); }
:ftoi.rz eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x1 & imm1619=0xf { eregA = trunc(eregC); }
:ftoi.rp eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x2 & imm1619=0xf { eregA = trunc(ceil(eregC)); }
:ftoi.rm eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x3 & imm1619=0xf { eregA = trunc(floor(eregC)); }
:ftou.rn eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x4 & imm1619=0xf { eregA = trunc(round(eregC)); }
:ftou.rz eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x5 & imm1619=0xf { eregA = trunc(eregC); }
:ftou.rp eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x6 & imm1619=0xf { eregA = trunc(ceil(eregC)); }
:ftou.rm eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x7 & imm1619=0xf { eregA = trunc(floor(eregC)); }
:itof eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x8 & imm1619=0xf { eregA = int2float(eregC); }
:utof eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0x9 & imm1619=0xf
{
    local t:8 = zext(eregC);
    eregA = int2float(t);
}
:ftoh eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0xa & imm1619=0xf { eregA[0,16] = FloatToHalf(eregC); }
:htof eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0xb & imm1619=0xf { eregA = HalfToFloat(eregC:2); }
:frint.rn eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0xc & imm1619=0xf { eregA = round(eregC); }
:frint.rz eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0xd & imm1619=0xf
{
    local t:8 = trunc(eregC);
    eregA = int2float(t);
}
:frint.rp eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0xe & imm1619=0xf { eregA = ceil(eregC); }
:frint.rm eregA, eregC is group=7 & ins0011=0x53f ; eregA & eregC & imm2023=0xf & imm1619=0xf { eregA = floor(eregC); }
