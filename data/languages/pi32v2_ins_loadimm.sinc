##################
#
# Load Immediate
#
##################

###########################################################################################
# Sign-extended load
###########################################################################################

#
# rA = imm5s
# => movs rA, #imm8
#
:movs regAl, #imm8 is group=1 & ins0305=2 & ins0607=0 & regAl & imm0812
[ imm8 = -(((0xe0 | imm0812) ^ 0xff) + 1); ]
{
    v:1 = 0xe0 | imm0812;
    regAl = sext(v);
}

###########################################################################################
# Zero-extended load
###########################################################################################

#
# rA = imm8
# => mov rA, #imm8
#
:mov regAl, #imm8 is group=1 & ins0607=1 & regAl & imm0812 & imm0305
[ imm8 = (imm0305 << 5) | imm0812; ]
{
	regAl = imm8;
}

#
# rA = simm16 (sign-extended). The vendor shows e041 f000 = r1 = -4096 and e040 8000 = -32768;
# a zero-extended 0xffff is loaded with the 48-bit form instead (ffc0 ffff 0000).
# => mov rA, #simm16
#
:mov regA, #imm1631s is group=7 & ins0411=0x004 & regA ; imm1631s
{
	regA = imm1631s;
}

# ... more to follow ... #

#
# rA = imm32
# => mov rA, #imm32
:mov regA, #imm32 is group=7 & ins0412=0x1FC & regA ; imm1631 ; imm3247
[ imm32 = imm1631 | (imm3247 << 16); ]
{
	regA = imm32;
}

#
# srA = imm32
# => mov srA, #imm32
:mov sregA, #imm32 is group=7 & ins0412=0x1FE & sregA ; imm1631 ; imm3247
[ imm32 = imm1631 | (imm3247 << 16); ]
{
	sregA = imm32;
}

###########################################################################################
# Register low part load
###########################################################################################

#
# rA.l = imm16
# => movl rA, #imm16
#
:movl regA, #imm1631 is group=7 & ins0411=0x000 & regA ; imm1631
{
	regA[0,16] = imm1631;
}

###########################################################################################
# Register high part load
###########################################################################################

#
# rA.h = imm16
# => movh rA, #imm16
#
:movh regA, #imm1631 is group=7 & ins0411=0x001 & regA ; imm1631
{
	regA[16,16] = imm1631;
}
