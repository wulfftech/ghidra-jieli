##
# Signed conditional jumps (reg/reg/imm10)
##

#
# ifs (rB < rA) goto reladdr9
# => jl rB, rA, reladdr9
#
:jl eregA, regA, jaddr9e is group=7 & ins0412=0xd8 & regA; eregA & jaddr9e
{
    if (eregA s< regA)
        goto jaddr9e;
}

#
# ifs (rB > rA) goto reladdr9
# => jg rB, rA, reladdr9
#
:jg eregA, regA, jaddr9e is group=7 & ins0412=0xe0 & regA; eregA & jaddr9e
{
    if (eregA s> regA)
        goto jaddr9e;
