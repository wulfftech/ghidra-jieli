# ifs (rB >= rA) goto reladdr9
# => jge rB, rA, reladdr9
#
:jge eregA, regA, jaddr9e is group=7 & ins0412=0xd0 & regA; eregA & jaddr9e
{
    if ((eregA s> regA) || (eregA == regA))
        goto jaddr9e;
